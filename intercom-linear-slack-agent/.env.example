# ── Scalekit ──────────────────────────────────────────────────────────────────
# Get from app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_secret_here

# ── Connector user identifiers ────────────────────────────────────────────────
# The email used to identify this user across all three connectors
INTERCOM_USER=you@yourcompany.com
LINEAR_USER=you@yourcompany.com
SLACK_USER=you@yourcompany.com

# ── Connector names ───────────────────────────────────────────────────────────
# Must match the connection names in your Scalekit dashboard EXACTLY,
# including any auto-generated suffix (e.g., slack-sKfekCVz).
# Dashboard → Agent Auth → Connections → copy the connection name.
INTERCOM_CONNECTOR=intercom
LINEAR_CONNECTOR=linear
SLACK_CONNECTOR=slack

# ── Linear ────────────────────────────────────────────────────────────────────
# Team ID to create issues under.
# Find in Linear: Settings → Workspace → API → copy Team ID.
LINEAR_TEAM_ID=your-linear-team-id

# ── Slack channels ────────────────────────────────────────────────────────────
# P0 escalations (high-value customers) go to SLACK_CHANNEL_ESCALATIONS.
# P1 escalations (standard accounts) go to SLACK_CHANNEL_TRIAGE.
# For private channels, invite the bot with /invite @your-bot-name first.
SLACK_CHANNEL_ESCALATIONS=#customer-support
SLACK_CHANNEL_TRIAGE=#support-engineering

# ── Escalation thresholds ─────────────────────────────────────────────────────
# A conversation is escalated if its cumulative signal score is ≥ 0.4.
# MRR_THRESHOLD decides P0 vs P1 routing (customer MRR in USD/mo).
ESCALATION_MRR_THRESHOLD=500
ESCALATION_MAX_OPEN_HOURS=24
ESCALATION_MAX_REPLIES=3

# ── Polling mode (optional) ───────────────────────────────────────────────────
# POLLING_MODE=false  → run once and exit (default; good for cron)
# POLLING_MODE=true   → loop every POLL_INTERVAL_MINUTES until Ctrl+C
POLLING_MODE=false
POLL_INTERVAL_MINUTES=2
